# Caddy: HTTPS для веб-клиента и API, WebSocket, а также выпуск сертификатов
# для coturn (TURN over TLS). Сертификаты автоматически перевыпускаются Caddy.
# Доступные логи пишутся в /data/access.log — fail2ban банит IP по 401 на
# /api/login и /api/register.

{$DOMAIN} {
	encode zstd gzip

	log {
		output file /data/access.log
	}

	# Безопасность: HSTS, защита от XSS-поверхностей (CSP), кликджекинга,
	# sniffing и утечек Referer. style-src с 'unsafe-inline' обязателен —
	# Vue инжектит стили и inline-атрибуты; connect-src wss: нужен для
	# сигналинга LiveKit; img/media https: — для GIF Klipy и медиа.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; media-src 'self' blob: https:; connect-src 'self' wss:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	}

	# Сигналинг LiveKit: клиент подключается к wss://домен/rtc/... напрямую
	# (путь /rtc/* свободен, префикс резать не нужно). livekit работает на
	# host-сети и не виден по имени в docker-сети — проксируем через host-gateway.
	# Точный /rtc тоже обязателен: старые клиенты/инструменты используют
	# фолбэк-путь /rtc (без /v1).
	handle /rtc {
		reverse_proxy host.docker.internal:7880
	}
	handle /rtc/* {
		reverse_proxy host.docker.internal:7880
	}

	handle /api/* {
		reverse_proxy server:8080
	}

	handle /ws {
		reverse_proxy server:8080
	}

	handle {
		root * /srv
		file_server
		try_files {path} /index.html
	}
}
