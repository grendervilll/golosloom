# Caddy: HTTPS для веб-клиента и API, WebSocket, а также выпуск сертификатов
# для coturn (TURN over TLS). Сертификаты автоматически перевыпускаются Caddy.

{$DOMAIN} {
	encode zstd gzip

	# Сигналинг LiveKit через публичный WSS (медиа идёт напрямую по UDP).
	# livekit работает на host-сети и не виден по имени в docker-сети,
	# поэтому проксируем через host-gateway. Префикс /livekit срезается:
	# LiveKit ожидает пути от корня (/rtc/v1/...).
	handle /livekit/* {
		uri strip_prefix /livekit
		reverse_proxy host.docker.internal:7880
	}

	handle /api/* {
		reverse_proxy server:8080
	}

	handle /ws {
		reverse_proxy server:8080
	}

	handle {
		root * /srv
		file_server
		try_files {path} /index.html
	}
}
