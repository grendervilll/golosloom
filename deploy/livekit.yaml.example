# Пример конфигурации LiveKit. Реальный файл генерируется install.sh
# (переменная LIVEKIT_CONFIG из .env, по умолчанию /opt/golosloom/livekit.yaml).
#
# Внутренний TURN LiveKit отключён: ретрансляция идёт через отдельный coturn,
# адреса которого клиенты получают из /api/config и передают в Room как iceServers.
# use_external_ip: false — при host-сети локальный IP LiveKit и есть публичный.
# congestion_control отключён: на слабых VPS он урезает канал до ~45 кбит/с.
# Лимиты комнат: защита слабого VPS (1 CPU / 1-2 ГБ) от перегруза.
port: 7880
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50100
  use_external_ip: false
  congestion_control:
    enabled: false
  allow_tcp_fallback: true
room:
  # Максимум участников в комнате (расчёт — 10-20 человек, запас 30).
  max_participants: 30
  # Пустая комната закрывается сама через 5 минут — авто-очистка.
  empty_timeout: 300
  # Отвалившийся участник удаляется через 2 минуты (запас для слабого
  # мобильного интернета; без этого брошенные устройства висят вечно).
  departure_timeout: 120
limit:
  # Максимум публикуемых треков на участника: голос + камера + экран.
  # Один клиент не сможет залить SFU потоками.
  num_tracks: 3
keys:
  api-key: api-secret
logging:
  level: info
