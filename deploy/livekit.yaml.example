# Пример конфигурации LiveKit. Реальный файл генерируется install.sh
# (переменная LIVEKIT_CONFIG из .env, по умолчанию /opt/golosloom/livekit.yaml).
port: 7880
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50100
  use_external_ip: true
  enable_tcp_loopback: true
stun_servers:
  - stun:stun.l.google.com:19302
turn:
  enabled: true
  domain: chat.example.com
  tls_port: 5349
  udp_port: 3478
  external_tls: true
  tls_cert: /certs/fullchain.pem
  tls_key: /certs/privkey.pem
  dh_file: /certs/dhparam.pem
logging:
  level: info
