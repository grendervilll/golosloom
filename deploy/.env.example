# Переменные окружения для Docker Compose.
# Копируйте в .env и заполняйте; скрипт install.sh делает это автоматически.
DOMAIN=chat.example.com
TURN_REALM=chat.example.com
TURN_SHARED_SECRET=сгенерируйте_случайный_секрет
LIVEKIT_API_KEY=сгенерируйте_ключ
LIVEKIT_API_SECRET=сгенерируйте_секрет
JWT_SECRET=сгенерируйте_секрет
TURN_URLS=turn:chat.example.com:3478?transport=udp,turn:chat.example.com:3478?transport=tcp,turns:chat.example.com:5349
