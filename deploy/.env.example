# Переменные окружения для Docker Compose.
# Копируйте в .env и заполняйте; скрипт install.sh делает это автоматически.
DOMAIN=chat.example.com
TURN_REALM=chat.example.com
TURN_SHARED_SECRET=сгенерируйте_случайный_секрет
LIVEKIT_API_KEY=сгенерируйте_ключ
LIVEKIT_API_SECRET=сгенерируйте_секрет
JWT_SECRET=сгенерируйте_секрет
# Centrifugo (ОТДЕЛЬНЫЙ секрет от JWT_SECRET)
CENTRIFUGO_URL=http://centrifugo:8000
CENTRIFUGO_API_KEY=сгенерируйте_ключ
CENTRIFUGO_ADMIN_KEY=сгенерируйте_ключ
CENTRIFUGO_SECRET=сгенерируйте_другой_секрет
# Web Push-уведомления (генерируются install.sh; без ключей пуши отключены)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Нативные пуши Android (FCM): путь к файлу сервисного аккаунта Firebase
FCM_SERVICE_ACCOUNT_FILE=/opt/golosloom/fcm-service-account.json
# Поиск GIF в чате: ключ Klipy (https://partner.klipy.com/api-keys).
GIF_API_KEY=
TURN_URLS=turn:chat.example.com:3478?transport=udp,turn:chat.example.com:3478?transport=tcp
# CORS: веб-клиент, Electron (file://) и локальная разработка
ALLOW_ORIGINS=https://chat.example.com,http://localhost:5173,http://localhost:3000,tauri://localhost,http://tauri.localhost,file://,null,capacitor://*,tauri://*
# Каталог данных (БД, сертификаты, Caddy) — вне репозитория
DATA_DIR=/opt/golosloom/data
# Каталог аватаров пользователей
AVATAR_DIR=/data/avatars
# Конфигурация LiveKit генерируется install.sh
LIVEKIT_CONFIG=/opt/golosloom/livekit.yaml
